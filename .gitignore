# Local staging for the external code-evaluation container. Candidate snapshots and
# generated results remain local. The compact trusted /test_files bundle is versioned.
/workspace/
/eval/

# Evaluation runs remain local; the official 4096 SPP Offline reference is versioned.
/test-results/*
!/test-results/references/
/test-results/references/*
!/test-results/references/official-4096-v3/
/test-results/references/official-4096-v3/*
!/test-results/references/official-4096-v3/cases/
!/test-results/references/official-4096-v3/cases/*/
!/test-results/references/official-4096-v4/
/test-results/references/official-4096-v4/*
!/test-results/references/official-4096-v4/cases/
!/test-results/references/official-4096-v4/cases/*/

# These large AOVs are not consumed by the evaluator and can be reconstructed from a new render.
/test-results/references/official-4096-v3/cases/*/offline-linear.pfm
/test-results/references/official-4096-v3/cases/*/offline-direct-linear.pfm
/test-results/references/official-4096-v4/cases/*/offline-linear.pfm
/test-results/references/official-4096-v4/cases/*/offline-direct-linear.pfm
